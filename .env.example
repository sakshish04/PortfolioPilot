# Copy to a local .env file; never commit real secrets.
# `pnpm dev` / `pnpm start` set NODE_ENV themselves (scripts/with-node-env.mjs).
NODE_ENV=development
PORT=3000

# REQUIRED for accounts, sessions and saved portfolio state.
# Any MySQL-compatible server (MySQL 8 / MariaDB). Create an empty database first,
# then run `pnpm db:migrate`. URL-encode special characters in the password.
# Example: mysql://portfolio_user:change-me@localhost:3306/portfolio_pilot
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# ---------------------------------------------------------------------------
# OPTIONAL: Coach / report AI. Leave both blank to disable AI entirely.
# NOT needed for local development, email/password sign-in, demo mode or any
# deterministic analytics.
# The MANUS_ prefix is historical: these point the server at an OpenAI-style HTTP API.
# When set AND a signed-in user has opted in, the server sends that provider the
# user's free-text Coach question plus a minimized numeric portfolio summary.
# Without them the deterministic answers are used and no AI request is made.
# Both values are read only by the server (server/_core/llm.ts); no endpoint sends them
# to the browser.
# ---------------------------------------------------------------------------
MANUS_API_URL=
MANUS_API_KEY=
